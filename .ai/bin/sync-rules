#!/usr/bin/env bash
#
# sync-rules — generate every coding agent's rule files from one source.
#
# Source of truth: .ai/rules/*.md (flat; index.md excluded), each opening with the frontmatter
# Laravel Boost writes back:
#
#     ---
#     paths:
#       - '**/*.php'
#       - composer.json
#     ---
#
# A rule whose paths include '**' applies to every file.
#
# Agents are listed in .ai/agents, one key per line. Each gets its own native format:
#
#     claude        .claude/rules/ai-<rule>.md                      paths:
#     cursor        .cursor/rules/ai-<rule>.mdc                     globs: + alwaysApply:
#     copilot       .github/instructions/ai-<rule>.instructions.md  applyTo:
#     windsurf      .windsurf/rules/ai-<rule>.md                    trigger: + globs:
#     antigravity   .agents/rules/ai-<rule>.md                      trigger: + description: + globs:
#     kiro          .kiro/steering/ai-<rule>.md                     inclusion: + fileMatchPattern:
#     gemini        .gemini/settings.json, created only when absent, so Gemini CLI reads AGENTS.md
#     codex         nothing: Codex reads AGENTS.md, which points every agent at .ai/rules/index.md
#
# It also regenerates .ai/rules/index.md byte for byte as Boost does, and reports any source whose
# frontmatter Boost would rewrite, so the two tools never fight.
#
# Usage:
#     .ai/bin/sync-rules            write what is stale; remove generated files whose source or
#                                   agent is gone
#     .ai/bin/sync-rules --check    change nothing; report drift; exit 1 if there is any
#
# A generated file carries a marker line; files without it are never overwritten or removed.
# Portable: bash 3.2 or later and POSIX awk, sed, grep, find, cmp. No git, no network.

set -u
export LC_ALL=C

MARKER='<!-- Generated by .ai/bin/sync-rules from'
PREFIX='ai-'
KNOWN='claude codex cursor copilot windsurf antigravity gemini kiro'
AGENT_DIRS='.claude/rules .cursor/rules .github/instructions .windsurf/rules .agents/rules .kiro/steering'

usage() {
    printf 'usage: .ai/bin/sync-rules [--check]\n'
}

die() {
    printf 'sync-rules: %s\n' "$1" >&2
    exit 2
}

report() {
    printf '%s\n' "$1"
    problems=$((problems + 1))
}

read_agents() {
    agents=' '
    [ -f .ai/agents ] || return 0
    set -f
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        set -- $line
        [ $# -gt 0 ] || continue
        case " $KNOWN " in
            *" $1 "*) agents="$agents$1 " ;;
            *) die "unknown agent '$1' in .ai/agents (known: $KNOWN)" ;;
        esac
    done < .ai/agents
    set +f
}

enabled() {
    case $agents in *" $1 "*) return 0 ;; esac
    return 1
}

# Parse one source rule into: name, globs (one per line), title, always, and $stage/.body.
parse_rule() {
    src=$1
    name=$(basename "$src" .md)
    tr -d '\r' < "$src" > "$stage/.src"
    globs=$(awk '
        NR == 1 { if ($0 !~ /^---[ \t]*$/) exit; fm = 1; next }
        fm && /^---[ \t]*$/ { exit }
        fm && /^paths:/ { inpaths = 1; next }
        fm && inpaths && /^[ \t]*-/ {
            g = $0
            sub(/^[ \t]*-[ \t]*/, "", g); sub(/[ \t]*$/, "", g)
            if (g ~ /^'\''.*'\''$/ || g ~ /^".*"$/) g = substr(g, 2, length(g) - 2)
            print g
            next
        }
        fm && /^[^ \t]/ { inpaths = 0 }
    ' "$stage/.src")
    [ -n "$globs" ] || die "$src has no paths: frontmatter"
    awk '
        NR == 1 && /^---[ \t]*$/ { fm = 1; next }
        fm == 1 && /^---[ \t]*$/ { fm = 2; next }
        fm != 1 { print }
    ' "$stage/.src" > "$stage/.body"
    title=$(sed -n 's/^# *//p' "$stage/.body" | sed -n 1p)
    always=no
    if printf '%s\n' "$globs" | grep -qxF '**'; then always=yes; fi
}

# Quote a glob the way Symfony's YAML dumper does, so Boost writes the same bytes back.
yaml_item() {
    case $1 in
        *[[:space:]]* | *\'* | *\"* | *:* | *\{* | *\}* | *\[* | *\]* | *,* | *\&* | *\** | *\#* | *\?*)
            printf "'%s'" "$1" ;;
        *)
            printf '%s' "$1" ;;
    esac
}

boost_frontmatter() {
    printf -- '---\npaths:\n'
    printf '%s\n' "$globs" | while IFS= read -r g; do
        printf '  - %s\n' "$(yaml_item "$g")"
    done
    printf -- '---\n'
}

# join_globs <separator> <quote>
join_globs() {
    printf '%s\n' "$globs" | awk -v sep="$1" -v q="$2" 'NF { printf "%s%s%s%s", (n++ ? sep : ""), q, $0, q }'
}

yaml_string() {
    printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# Set out (target path) and fm (frontmatter, possibly empty) for one agent.
render() {
    out=''
    fm=''
    case $1 in
        claude)
            out=".claude/rules/$PREFIX$name.md"
            if [ "$always" = no ]; then fm=$(boost_frontmatter); fi
            ;;
        cursor)
            out=".cursor/rules/$PREFIX$name.mdc"
            if [ "$always" = yes ]; then
                fm=$(printf -- '---\nalwaysApply: true\n---')
            else
                fm=$(printf -- '---\nglobs: %s\nalwaysApply: false\n---' "$(join_globs ', ' '')")
            fi
            ;;
        copilot)
            out=".github/instructions/$PREFIX$name.instructions.md"
            if [ "$always" = yes ]; then
                fm=$(printf -- '---\napplyTo: "**"\n---')
            else
                fm=$(printf -- '---\napplyTo: "%s"\n---' "$(join_globs ',' '')")
            fi
            ;;
        windsurf)
            out=".windsurf/rules/$PREFIX$name.md"
            if [ "$always" = yes ]; then
                fm=$(printf -- '---\ntrigger: always_on\n---')
            else
                fm=$(printf -- '---\ntrigger: glob\nglobs: "%s"\n---' "$(join_globs ', ' '')")
            fi
            ;;
        antigravity)
            out=".agents/rules/$PREFIX$name.md"
            if [ "$always" = yes ]; then
                fm=$(printf -- '---\ntrigger: always_on\ndescription: %s\n---' "$(yaml_string "$title")")
            else
                fm=$(printf -- '---\ntrigger: glob\ndescription: %s\nglobs: "%s"\n---' \
                    "$(yaml_string "$title")" "$(join_globs ', ' '')")
            fi
            ;;
        kiro)
            out=".kiro/steering/$PREFIX$name.md"
            if [ "$always" = yes ]; then
                fm=$(printf -- '---\ninclusion: always\n---')
            else
                fm=$(printf -- '---\ninclusion: fileMatch\nfileMatchPattern: [%s]\n---' "$(join_globs ', ' '"')")
            fi
            ;;
    esac
}

stage_rule_file() {
    dest="$stage/out/$out"
    mkdir -p "$(dirname "$dest")"
    {
        if [ -n "$fm" ]; then printf '%s\n' "$fm"; fi
        printf '%s %s. Edit the source, then run .ai/bin/sync-rules. -->\n' "$MARKER" "$src"
        cat "$stage/.body"
    } > "$dest"
}

stage_index() {
    mkdir -p "$stage/out/.ai/rules"
    {
        printf '# Project Rules Index\n\n'
        printf "Before planning or editing, find the row whose globs match the file's path and read that rule file.\n\n"
        printf '| Applies to | Rule file |\n| --- | --- |\n'
        cat "$stage/.rows"
    } > "$stage/out/.ai/rules/index.md"
}

stage_gemini() {
    if [ -f .gemini/settings.json ]; then
        grep -q 'AGENTS\.md' .gemini/settings.json ||
            report 'conflict: .gemini/settings.json exists without AGENTS.md in context.fileName — add it by hand'
        return 0
    fi
    mkdir -p "$stage/out/.gemini"
    printf '{\n  "context": {\n    "fileName": ["AGENTS.md", "GEMINI.md"]\n  }\n}\n' > "$stage/out/.gemini/settings.json"
}

apply() {
    (cd "$stage/out" && find . -type f) | sed 's|^\./||' | sort > "$stage/.list"
    while IFS= read -r rel; do
        if [ -f "$rel" ] && cmp -s "$stage/out/$rel" "$rel"; then
            continue
        fi
        if [ -f "$rel" ] && [ "$rel" != .ai/rules/index.md ] && ! grep -qF "$MARKER" "$rel"; then
            report "conflict: $rel exists and was not generated — rename or remove it, then re-run"
            continue
        fi
        if [ "$mode" = check ]; then
            if [ -f "$rel" ]; then report "stale: $rel"; else report "missing: $rel"; fi
        else
            mkdir -p "$(dirname "$rel")"
            cp "$stage/out/$rel" "$rel"
            printf 'wrote: %s\n' "$rel"
        fi
    done < "$stage/.list"

    for dir in $AGENT_DIRS; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] || continue
            grep -qF "$MARKER" "$f" || continue
            grep -qxF "$f" "$stage/.list" && continue
            if [ "$mode" = check ]; then
                report "orphan: $f"
            else
                rm -f "$f"
                printf 'removed: %s\n' "$f"
            fi
        done
    done
}

main() {
    mode=write
    case ${1-} in
        '') ;;
        --check) mode=check ;;
        -h | --help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac

    root=$(cd "$(dirname "$0")/../.." && pwd) || exit 2
    cd "$root" || exit 2
    [ -d .ai/rules ] || die 'no .ai/rules directory'

    stage=$(mktemp -d "${TMPDIR:-/tmp}/sync-rules.XXXXXX") || die 'cannot create a temporary directory'
    trap 'rm -rf "$stage"' EXIT
    problems=0

    read_agents
    : > "$stage/.rows"

    for src in .ai/rules/*.md; do
        [ -f "$src" ] || continue
        [ "$src" = .ai/rules/index.md ] && continue
        parse_rule "$src"

        expected=$(boost_frontmatter)
        actual=$(awk 'NR == 1 && !/^---$/ { exit } { print } NR > 1 && /^---$/ { exit }' "$stage/.src")
        if [ "$actual" != "$expected" ]; then
            report "frontmatter: $src is not in the form Laravel Boost writes back; expected:"
            printf '%s\n' "$expected" | sed 's/^/    /'
        fi

        printf '| %s | .ai/rules/%s.md |\n' "$(join_globs ', ' '')" "$name" >> "$stage/.rows"

        for agent in claude cursor copilot windsurf antigravity kiro; do
            enabled "$agent" || continue
            render "$agent"
            stage_rule_file
        done
    done

    stage_index
    if enabled gemini; then stage_gemini; fi
    apply

    if [ "$problems" -gt 0 ]; then
        printf 'sync-rules: %d problem(s)\n' "$problems"
        exit 1
    fi
    if [ "$mode" = check ]; then printf 'sync-rules: in sync\n'; fi
}

main "$@"
